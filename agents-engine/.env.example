# =============================================================================
# AEGIS Ω Intelligence Engine — Environment Configuration
# =============================================================================

# --- Gemini GenAI & Vertex AI Configuration ---
# REQUIRED: Google Gemini API Key. Never commit this key to version control.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Runtime & Cloud Run Settings ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
PORT=8080
HOST=0.0.0.0

# --- Google Cloud Project Configuration ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# --- Google Cloud Pub/Sub ---
# Set to true in Cloud Run environment
ENABLE_GCP_PUBSUB=false
PUBSUB_TOPIC_PREFIX=
# PUBSUB_EMULATOR_HOST=localhost:8085

# --- Google Cloud SQL (PostgreSQL) ---
# Set to true in Cloud Run environment
ENABLE_CLOUD_SQL=false
CLOUD_SQL_CONNECTION_NAME=your-gcp-project-id:us-central1:aegis-db
CLOUD_SQL_DATABASE=aegis_omega
CLOUD_SQL_USER=aegis_app
CLOUD_SQL_PASSWORD=your_secure_db_password_here
# CLUID_SQL_HOST=/cloudsql/your-gcp-project-id:us-central1:aegis-db

# --- Google Cloud Firestore ---
# Set to true in Cloud Run environment
ENABLE_FIRESTORE=false
FIRESTORE_DATABASE_ID=(default)

# --- OpenTelemetry Tracing ---
OTEL_SERVICE_NAME=aegis-omega-intelligence-engine
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# --- Digital World (Member 1) Configuration ---
DIGITAL_WORLD_API_BASE_URL=http://localhost:8080/api/v1
DIGITAL_WORLD_WS_STREAM_URL=ws://localhost:8080/api/v1/events/stream
DIGITAL_WORLD_API_KEY=
